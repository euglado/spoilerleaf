{
  "name": "spoilerleaf",
  "version": "1.0.0",
  "private": true,
  "description": "Consent-first spoiler cards for Discord communities",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.13.0 <25" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc",
    "lint": "biome check src test scripts",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run lint && npm test && node scripts/check-supply.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "register": "node --env-file-if-exists=.env dist/register.js"
  },
  "dependencies": { "discord.js": "14.27.0" },
  "devDependencies": { "@biomejs/biome": "2.5.15", "@types/node": "24.19.2", "typescript": "7.0.2" }
}
